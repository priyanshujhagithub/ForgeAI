# Copy to .env and fill in. Never commit .env.

# GitHub OAuth app (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Signs login tokens. Any long random string: openssl rand -base64 48
JWT_SECRET=

# Encrypts stored GitHub tokens. Exactly 32 bytes, base64: openssl rand -base64 32
# If this is lost or changed, users must reconnect GitHub.
FORGEAI_ENCRYPTION_KEY=

# LLM provider. Defaults target local Ollama; any OpenAI-compatible endpoint works.
LLM_BASE_URL=http://localhost:11434/v1/
LLM_API_KEY=ollama
LLM_MODEL=forgeai-qwen3
# For a hosted provider with rate limits, let the client wait and retry on HTTP 429:
# LLM_MAX_RETRIES=3
# Some providers reject the reasoning_effort parameter; set it empty to stop sending it:
# LLM_REASONING_EFFORT=

# E2B sandbox (free Hobby tier, no payment method)
E2B_API_KEY=

# Langfuse tracing (free Hobby tier). Leave blank to disable tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional: E2B template with a JDK for Maven/Gradle repositories (see infrastructure/e2b)
E2B_TEMPLATE_JAVA=

# Optional: where the web app is served, if not http://localhost:5180.
# The GitHub OAuth callback redirects back here, and only this address may
# call the API from a browser.
# FORGEAI_FRONTEND_URL=http://localhost:5180

# ---- Only needed when deployed (see docs/deployment.md and render.yaml) ----
# DATABASE_URL=jdbc:postgresql://HOST/DATABASE?sslmode=require
# DATABASE_USERNAME=
# DATABASE_PASSWORD=
# GITHUB_REDIRECT_URI=https://YOUR-API/api/v1/auth/github/callback
# AI_SERVICE_BASE_URL=https://YOUR-AI-SERVICE
# Shared secret between the API and the AI service; both must have the same value.
# AI_SERVICE_TOKEN=
# Who may start runs (comma-separated), and how many runs per account per UTC day.
# FORGEAI_ALLOWED_EMAILS=you@example.com
# FORGEAI_DAILY_RUN_LIMIT=10
